# ── Telegram ──────────────────────────────────────────────────────────────────
# Token obtenido con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNOpqRSTUvwxYZ

# Tu chat_id (usa @userinfobot para obtenerlo; también puede ser ID de grupo/canal)
TELEGRAM_CHAT_ID=987654321

# ── Polling ───────────────────────────────────────────────────────────────────
# El bot elige aleatoriamente un intervalo entre MIN y MAX para evitar patrones.
POLL_INTERVAL_MIN=8
POLL_INTERVAL_MAX=15

# Delay en segundos entre cada término de búsqueda (dentro del mismo ciclo)
REQUEST_DELAY_MIN=8.0
REQUEST_DELAY_MAX=20.0

# ── Detección de gangas ───────────────────────────────────────────────────────
# Ratio: dispara alerta si precio_listing < precio_ref × DISCOUNT_THRESHOLD
# 0.75 → necesita al menos 25% de descuento
DISCOUNT_THRESHOLD=0.75

# Precio mínimo (€) para considerar un listing — evita spam/scams
MIN_PRICE=3.0

# Precio máximo (€) — evita falsos positivos en bundles caros
MAX_PRICE=500.0

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_PATH=vinted_pokemon.db

# Días tras los cuales se borran listings no-ganga (limpieza automática al iniciar)
DB_CLEANUP_DAYS=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=bot.log
# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Vinted ────────────────────────────────────────────────────────────────────
# Dominio según país:
#   España:    www.vinted.es
#   Francia:   www.vinted.fr
#   Reino Unido: www.vinted.co.uk
#   Alemania:  www.vinted.de
#   Italia:    www.vinted.it
#   Portugal:  www.vinted.pt
VINTED_DOMAIN=www.vinted.es

# ── Exclusiones ───────────────────────────────────────────────────────────────
# Usernames de vendedores a ignorar (separados por comas, sin espacios extra)
EXCLUDED_SELLERS=vendedor_spam,otro_indeseable

# ── Términos de búsqueda (opcional) ──────────────────────────────────────────
# Sobreescribe los términos por defecto si se especifica.
# Si no se define, usa los términos incorporados en config.py.
# SEARCH_TERMS=pokemon,pokémon,nintendo ds pokemon,gameboy pokemon
