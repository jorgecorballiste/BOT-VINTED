# ── Telegram ──────────────────────────────────────────────────────────────────
# Obtén tu token con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNOpqRSTUvwxYZ

# Tu chat_id personal (usa @userinfobot para obtenerlo)
# También puede ser el ID de un grupo/canal
TELEGRAM_CHAT_ID=987654321

# ── Polling ───────────────────────────────────────────────────────────────────
# Intervalo entre ciclos (minutos). Se elige aleatoriamente en este rango.
POLL_INTERVAL_MIN=8
POLL_INTERVAL_MAX=15

# Delay entre requests individuales (segundos)
REQUEST_DELAY_MIN=8.0
REQUEST_DELAY_MAX=20.0

# ── Detección de gangas ───────────────────────────────────────────────────────
# Ratio: precio_listing < precio_ref * DISCOUNT_THRESHOLD → ganga
# 0.75 = precio al menos 25% más barato que la referencia
DISCOUNT_THRESHOLD=0.75

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_PATH=vinted_pokemon.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=bot.log

# ── Vinted ────────────────────────────────────────────────────────────────────
# Dominio de Vinted según tu país:
#   España:  www.vinted.es
#   Francia: www.vinted.fr
#   UK:      www.vinted.co.uk
#   Alemania: www.vinted.de
VINTED_DOMAIN=www.vinted.es

# ── Exclusiones ───────────────────────────────────────────────────────────────
# Lista de vendedores a ignorar, separados por comas (sin espacios extra)
EXCLUDED_SELLERS=vendedor_spam,otro_vendedor
